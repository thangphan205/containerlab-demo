#!/usr/sbin/nft -f

flush ruleset

table inet filter {
    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept

        # Cho phép giám sát/ping xuyên subnet (yêu cầu của team NOC)
        ip protocol icmp accept

        # LAN chi nhánh truy cập hệ thống đặt hàng
        ip saddr 192.168.20.0/26 tcp dport 80 accept
    }
}
